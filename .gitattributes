* text=auto eol=lf
*.blade.php diff=php
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php
*.vue diff=vue
/.github export-ignore
CHANGELOG.md export-ignore
.styleci.yml export-ignore
# Vue-Dateien als Vue erkennen
*.vue linguist-detectable=true
*.vue linguist-language=Vue
# Vendor & Node ignorieren
node_modules/*.js linguist-vendored
vendor/*.js linguist-vendored
# Nur Tailwind CSS im public ausschließen
public/css/tailw/*.css linguist-vendored
*.zip filter=lfs diff=lfs merge=lfs -text
node_modules/** linguist-vendored
vendor/** linguist-vendored
public/build/** linguist-generated=true
dist/** linguist-generated=true
bootstrap/** linguist-generated=true
storage/** linguist-generated=true
